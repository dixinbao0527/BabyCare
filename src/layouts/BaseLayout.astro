---
import '../styles/global.css';
import GlobalSearch from '../components/GlobalSearch.astro';
import { withBase, SITE_NAME, NAV } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  nav?: 'home' | 'health' | 'quick' | 'milestones' | 'feeding' | 'outdoor' | 'about' | 'sources' | 'none';
  /** 急症页用：不渲染页头，让红色警示条成为页面第一个元素，严格贴顶（A-8） */
  bare?: boolean;
}

const {
  title,
  description = '0～3 岁婴幼儿健康养育手册：按月龄组织的喂养、睡眠、发育、安全与日常照护知识，每条都可溯源到国家卫健委发布的指南，并参考 WHO 与 AAP 公开资料。',
  nav = 'none',
  bare = false,
} = Astro.props;

/** 构建日期：页脚不再写死某一天，避免内容更新后仍显示旧日期 */
const BUILD_DATE = new Date().toISOString().slice(0, 10);

const pageTitle = title === SITE_NAME ? title : `${title}｜${SITE_NAME}`;
/** 急症速查页自身不再显示常驻入口，避免自己链自己 */
const onQuickPage = Astro.url.pathname.includes('/quick');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.github.io');
const ogImage = new URL(withBase('/og.png'), Astro.site ?? 'https://example.github.io').href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#faf8f4" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="婴幼儿健康养育手册：0～3 岁按月龄组织的可溯源知识" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index,follow" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    {!bare && (
    <header class="site-header">
      <div class="wrap-wide inner">
        <a class="brand" href={withBase('/')}>
          <span class="mark" aria-hidden="true">育</span>
          <span>{SITE_NAME}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          {
            NAV.map((item) => (
              <a
                href={withBase(item.href)}
                aria-label={item.label}
                aria-current={nav === item.key ? 'page' : undefined}
              >
                <span class="nav-full" aria-hidden="true">{item.label}</span>
                <span class="nav-short" aria-hidden="true">{item.short}</span>
              </a>
            ))
          }
        </nav>
        <GlobalSearch />
      </div>
    </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!bare && !onQuickPage && (
      <a class="emergency-fab" id="emergency-fab" href={withBase('/quick')} aria-label="急症与突发状况速查">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 6.5v11M6.5 12h11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <span>急症速查</span>
      </a>
    )}

    <footer class="site-footer">
      <div class="wrap-wide">
        <p class="disclaimer">
          本站为公益整理，内容依据国家卫健委、WHO、AAP 公开发布的指南整理，
          <strong>尚未经儿科医生逐条复核</strong>，<strong>不替代专业医疗诊断，也不构成用药建议</strong>。
          孩子出现急症表现时请立即就医或拨打 120；内容与指南原文有出入时，以原文为准。
        </p>
        <div class="foot-row">
          <span>最后更新：{BUILD_DATE} · 内容仅供健康教育参考</span>
          <span>
            <a href={withBase('/health')}>健康查询</a>
            <span aria-hidden="true"> · </span>
            <a href={withBase('/feeding')}>婴幼儿辅食</a>
            <span aria-hidden="true"> · </span>
            <a href={withBase('/about')}>关于本站</a>
            <span aria-hidden="true"> · </span>
            <a href={withBase('/sources')}>来源与免责声明</a>
            <span aria-hidden="true"> · </span>
            <button
              type="button"
              id="clear-storage"
              style="font:inherit;background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer;min-height:44px;display:inline-flex;align-items:center;"
            >
              清除本机记录
            </button>
          </span>
        </div>
      </div>
    </footer>

    <script>
      // 窄屏导航可横向滚动时，把当前页滚到中间，避免「关于」这类末项一开始在视野外
      const navBar = document.querySelector<HTMLElement>('.nav');
      const currentLink = navBar?.querySelector<HTMLElement>('a[aria-current="page"]') ?? null;

      function centerCurrentNav() {
        if (!navBar || !currentLink) return;
        if (navBar.scrollWidth <= navBar.clientWidth + 1) {
          navBar.scrollLeft = 0;
          return;
        }
        const bar = navBar.getBoundingClientRect();
        const link = currentLink.getBoundingClientRect();
        const target =
          navBar.scrollLeft + (link.left - bar.left) - (navBar.clientWidth - link.width) / 2;
        navBar.scrollLeft = Math.max(0, target);
      }

      centerCurrentNav();
      window.addEventListener('resize', centerCurrentNav, { passive: true });

      // 常驻急症入口：页脚进入视口时让位；页面上已有「急症」卡片时也不重复出现
      const fab = document.getElementById('emergency-fab');
      const siteFooter = document.querySelector('.site-footer');
      const inlineAcute = document.querySelector('.acute-entry');
      const stickyReferral = document.querySelector('.referral-bar');
      if (fab && 'IntersectionObserver' in window) {
        let footerOn = false;
        let inlineAcuteOn = false;
        let referralOn = false;
        const syncFab = () =>
          fab.classList.toggle('is-hidden', footerOn || inlineAcuteOn || referralOn);

        if (siteFooter) {
          new IntersectionObserver(
            (entries) => {
              footerOn = entries.some((e) => e.isIntersecting);
              syncFab();
            },
            { threshold: 0.05 }
          ).observe(siteFooter);
        }
        if (inlineAcute) {
          new IntersectionObserver(
            (entries) => {
              inlineAcuteOn = entries.some((e) => e.isIntersecting);
              syncFab();
            },
            { threshold: 0.15 }
          ).observe(inlineAcute);
        }
        if (stickyReferral) {
          new IntersectionObserver(
            (entries) => {
              referralOn = entries.some((e) => e.isIntersecting);
              syncFab();
            },
            { threshold: 0.1 }
          ).observe(stickyReferral);
        }
      }

      const btn = document.getElementById('clear-storage');
      btn?.addEventListener('click', () => {
        try {
          localStorage.removeItem('ich.birth.v1');
          localStorage.removeItem('ich.tasks.v1');
        } catch {
          /* 隐私模式下不可用，忽略 */
        }
        btn.textContent = '已清除';
        window.dispatchEvent(new CustomEvent('ich:storage-cleared'));
      });
    </script>
  </body>
</html>
