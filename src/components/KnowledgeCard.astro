---
import { render, getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { CATEGORY_META } from '../lib/stages';

interface Props {
  entry: CollectionEntry<'developmental'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.split('/').pop() ?? entry.id;
const cat = CATEGORY_META[entry.data.category];

// related 存的是 acute 的 slug，标题从合集里取，避免在本文件硬编码映射
const acutes = await getCollection('acute');
const titleOf = (s: string) => acutes.find((a) => a.id === s || a.id.split('/').pop() === s)?.data.title ?? s;
const related = entry.data.related.filter((s) => acutes.some((a) => a.id === s || a.id.split('/').pop() === s));
---

<details class={`kcard ${cat?.tone ?? ''}`} id={slug}>
  <summary>
    <span class="k">
      <span class="cat-badge" aria-hidden="true">{cat?.badge ?? '育'}</span>
      {entry.data.title}
    </span>
    <span class="sum">{entry.data.summary}</span>
    <span class="src">{entry.data.source.name}</span>
  </summary>
  <div class="body">
    <Content />
    <p class="srcline">
      来源：{entry.data.source.name}
      {entry.data.source.section ? ` · ${entry.data.source.section}` : ''}
      {entry.data.source.year ? ` · ${entry.data.source.year}` : ''}
    </p>
    {
      related.length > 0 && (
        <p class="related">
          相关急症：
          {related.map((r, i) => (
            <>
              {i > 0 && '、'}
              <a href={withBase(`/quick/${r}`)}>{titleOf(r)}</a>
            </>
          ))}
        </p>
      )
    }
  </div>
</details>
