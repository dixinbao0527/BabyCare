---
import { withBase } from '../lib/url';

const today = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
const todayStr = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
const minStr = `${today.getFullYear() - 6}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
---

<div class="picker" id="birth-picker">
  <label class="field-label" for="birth-date">宝宝出生日期</label>
  <div class="date-row">
    <input
      id="birth-date"
      type="date"
      inputmode="numeric"
      max={todayStr}
      min={minStr}
      autocomplete="off"
      aria-describedby="birth-hint"
    />
  </div>
  <p class="form-hint" id="birth-hint">用于定位月龄，只保存在你的设备上，不会上传。</p>

  <details class="ga-toggle">
    <summary>早产儿？填一下出生时的胎龄（可选）</summary>
    <div class="ga-body">
      <label for="ga-select">胎龄</label>
      <select id="ga-select">
        <option value="40" selected>40 周（足月）</option>
        {
          Array.from({ length: 19 }, (_, i) => 36 - i).map((w) => (
            <option value={String(w)}>{w} 周{w < 37 ? '（早产）' : ''}</option>
          ))
        }
      </select>
      <span class="small muted">不满 37 周时，按矫正月龄对照发育里程碑。</span>
    </div>
  </details>

  <p class="hero-example">还没记住生日？直接点成长轴上的阶段，或看<a href={withBase('/milestones')}>发育里程碑</a>。</p>

  <div class="age-result" id="age-result" aria-live="polite" hidden></div>

  <a class="acute-entry" href={withBase('/quick#q')} id="acute-entry">
    <span class="t">
      <span>孩子突发状况？直接查症状</span>
      <span aria-hidden="true">→</span>
    </span>
    <span class="d">咳嗽像犬吠、抽搐、误吞、烫伤、摔到头</span>
  </a>
</div>

<script>
  import { calcAge, parseBirthDate, formatDate } from '../lib/age';
  import { stageOf, STAGES, SCREEN_NODES } from '../lib/stages';
  import { withBase } from '../lib/url';

  const KEY = 'ich.birth.v1';
  const DEFAULT_RANGE = STAGES[0].range;

  const input = document.getElementById('birth-date') as HTMLInputElement | null;
  const gaSelect = document.getElementById('ga-select') as HTMLSelectElement | null;
  const result = document.getElementById('age-result');
  const titleEl = document.getElementById('hero-title');
  const stageNameEl = document.getElementById('stage-name');
  const stageTaglineEl = document.getElementById('stage-tagline');
  const stageMoreEl = document.getElementById('stage-more');
  const axisMarker = document.getElementById('axis-marker');
  const axisBubble = document.getElementById('axis-bubble');
  const axisCurrent = document.getElementById('axis-current');
  const statNext = document.getElementById('stat-next');
  const statNextLabel = document.getElementById('stat-next-label');
  const statCount = document.getElementById('stat-count');

  type Stored = { birth: string; ga: number };

  function readStore(): Stored | null {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<Stored>;
      if (typeof parsed?.birth !== 'string') return null;
      const ga = Number(parsed.ga);
      return { birth: parsed.birth, ga: Number.isFinite(ga) && ga >= 24 && ga <= 42 ? ga : 40 };
    } catch {
      return null;
    }
  }

  function writeStore(value: Stored | null) {
    try {
      if (value === null) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, JSON.stringify({ ...value, ts: Date.now() }));
    } catch {
      /* 隐私模式下静默降级 */
    }
  }

  function countFor(range: string): number {
    const panel = document.querySelector<HTMLElement>(`[data-stage-panel="${range}"]`);
    if (!panel) return 0;
    const total = Number(panel.dataset.count);
    if (Number.isFinite(total) && total > 0) return total;
    return panel.querySelectorAll('.entry-card').length;
  }

  function setCount(n: number) {
    if (!statCount) return;
    statCount.replaceChildren(document.createTextNode(String(n)));
    const small = document.createElement('small');
    small.textContent = '条';
    statCount.append(small);
  }

  function setDefaultAxis() {
    const base = STAGES[0];
    if (axisMarker) axisMarker.hidden = true;
    if (axisBubble) axisBubble.textContent = '';
    if (axisCurrent) {
      axisCurrent.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = `先看 ${base.name}`;
      axisCurrent.append(strong, ` · ${base.tagline}`);
    }
    if (statNext) statNext.textContent = '—';
    if (statNextLabel) statNextLabel.textContent = '下个筛查节点 · 填生日后显示';
    setCount(countFor(DEFAULT_RANGE));
  }

  function applyStage(range: string) {
    document.querySelectorAll<HTMLElement>('[data-stage-panel]').forEach((p) => {
      p.hidden = p.dataset.stagePanel !== range;
    });

    document.querySelectorAll<HTMLAnchorElement>('.stage-strip a').forEach((a) => {
      if (a.dataset.range === range) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });

    document.querySelectorAll<HTMLElement>('.axis-band').forEach((b) => {
      b.classList.toggle('is-current', b.dataset.band === range);
    });

    const stage = STAGES.find((s) => s.range === range);
    const count = countFor(range);
    if (stage) {
      if (stageNameEl) stageNameEl.textContent = stage.name;
      if (stageTaglineEl) stageTaglineEl.textContent = stage.tagline;
      if (stageMoreEl) {
        stageMoreEl.setAttribute('href', withBase(`/age/${range}`));
        stageMoreEl.textContent = `本阶段全部 ${count} 条 →`;
      }
    }
    setCount(count);
    window.dispatchEvent(new CustomEvent('ich:stage-changed', { detail: { range } }));
  }

  function setTitle(info: ReturnType<typeof calcAge>) {
    if (!titleEl) return;
    titleEl.replaceChildren(
      document.createTextNode(info.days === 0 ? '宝宝今天出生，' : `宝宝 ${info.months} 个月，`),
      document.createElement('br'),
      document.createTextNode('现在该注意什么？')
    );
  }

  function setAxis(info: ReturnType<typeof calcAge>, stage: { name: string; tagline: string }) {
    if (axisMarker && axisBubble) {
      const pct = Math.min(98, Math.max(2, (info.months / 36) * 100));
      axisMarker.hidden = false;
      axisMarker.style.left = `${pct}%`;
      axisBubble.textContent = `${info.months} 个月${info.corrected ? '（矫正）' : ''}`;
    }

    if (axisCurrent) {
      axisCurrent.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = stage.name;
      axisCurrent.append(strong, ` · ${stage.tagline}`);
      if (info.corrected) {
        const note = document.createElement('span');
        note.className = 'muted';
        note.textContent = '（按矫正月龄）';
        axisCurrent.append(note);
      }
    }

    const next = SCREEN_NODES.find((n) => n > info.months) ?? null;
    if (statNext) statNext.textContent = next === null ? '—' : `${next}`;
    if (statNextLabel) {
      statNextLabel.textContent =
        next === null
          ? info.months >= 36
            ? '已到 36 月龄最后一个节点'
            : '已超出手册覆盖的 0～36 个月'
          : `下个筛查节点 · ${next} 月龄`;
    }
  }

  function renderEmpty() {
    if (result) {
      result.hidden = true;
      result.replaceChildren();
    }
    if (titleEl) titleEl.textContent = '按月龄查，每条都能溯源';
    setDefaultAxis();
    applyStage(DEFAULT_RANGE);
  }

  function renderError(message: string) {
    if (!result) return;
    result.hidden = false;
    result.replaceChildren();
    const span = document.createElement('span');
    span.textContent = message;
    result.append(span);
    if (titleEl) titleEl.textContent = '按月龄查，每条都能溯源';
    setDefaultAxis();
    applyStage(DEFAULT_RANGE);
  }

  function renderAge(birth: Date, ga: number) {
    const info = calcAge(birth, new Date(), ga);
    const { stage, outOfRange } = stageOf(info.months);

    if (result) {
      result.hidden = false;
      result.replaceChildren();

      const line = document.createElement('span');
      line.append(info.days === 0 ? '宝宝今天出生，' : '宝宝现在 ');
      const strong = document.createElement('strong');
      strong.textContent = `${info.months} 个月`;
      line.append(strong, `，处于 ${stage.name}阶段。`);
      result.append(line);

      const link = document.createElement('a');
      link.href = withBase(`/age/${stage.range}`);
      link.textContent = `查看 ${stage.name} 全部内容 →`;
      link.style.fontWeight = '600';
      result.append(link);

      if (info.corrected) {
        const note = document.createElement('span');
        note.className = 'note';
        const extraDays = Math.round(info.correctedExtraDays);
        note.textContent = `因 ${ga} 周早产，以上为矫正月龄（${info.months} 个月${extraDays > 0 ? ` ${extraDays} 天` : ''}）；实际月龄 ${info.rawMonths} 个月。矫正至实际 24 个月为止。`;
        result.append(note);
      }

      if (outOfRange) {
        const note = document.createElement('span');
        note.className = 'note';
        note.textContent = '本手册覆盖 0～3 岁，当前已超出范围，内容可能不再适用。';
        result.append(note);
      }
    }

    setTitle(info);
    setAxis(info, stage);
    applyStage(stage.range);
  }

  function sync() {
    const value = input?.value ?? '';
    const birth = parseBirthDate(value);
    if (!birth) {
      if (value) renderError('出生日期不能晚于今天，请重新选择。');
      else renderEmpty();
      return;
    }
    const ga = Number(gaSelect?.value ?? 40);
    writeStore({ birth: formatDate(birth), ga });
    renderAge(birth, ga);
  }

  const stored = readStore();
  if (stored) {
    const d = parseBirthDate(stored.birth);
    if (d && input) {
      input.value = stored.birth;
      if (gaSelect) gaSelect.value = String(stored.ga);
      renderAge(d, stored.ga);
    } else {
      renderEmpty();
    }
  } else {
    renderEmpty();
  }

  input?.addEventListener('change', sync);
  input?.addEventListener('blur', sync);
  gaSelect?.addEventListener('change', sync);

  // 支持「今天出生」快速测试：URL 带 ?today=1
  if (new URLSearchParams(location.search).get('today') === '1' && input) {
    const t = new Date();
    const p = (n: number) => String(n).padStart(2, '0');
    input.value = `${t.getFullYear()}-${p(t.getMonth() + 1)}-${p(t.getDate())}`;
    sync();
  }

  window.addEventListener('ich:storage-cleared', () => {
    if (input) input.value = '';
    if (gaSelect) gaSelect.value = '40';
    renderEmpty();
  });
</script>
