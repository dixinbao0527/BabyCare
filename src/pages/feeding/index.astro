---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import feeding from '../../content/data/feeding.json';

const relatedHref = (r: { slug: string; age: string }) =>
  r.age === 'acute' ? withBase(`/quick/${r.slug}`) : withBase(`/age/${r.age}`) + '#' + r.slug;
---

<BaseLayout
  title={feeding.title}
  description="满 6 月龄起添加辅食：按月龄的频次与质地对照、五条添加原则、安全红线与常见误区。依据国家卫健委《婴幼儿喂养健康教育核心信息》与中国居民膳食指南（2022）。"
  nav="feeding"
>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">0～3 岁 · 喂养</p>
      <h1>{feeding.title}</h1>
      <p class="tagline">{feeding.tagline}</p>
    </div>

    <div class="fd-lead">
      <strong>一句话先记住：</strong>满 6 月龄开始加，先加含铁的泥糊状食物，每次只加一种、观察 2～3 天；
      1 岁以内不加盐、糖和调味品；继续母乳喂养可至 2 岁及以上。
    </div>

    <nav class="fd-toc" aria-label="本页目录">
      <a href="#timeline">按月龄怎么加</a>
      <a href="#table">频次与质地表</a>
      <a href="#principles">五条原则</a>
      <a href="#groups">7 类食物</a>
      <a href="#hazards">安全红线</a>
      <a href="#faq">常见疑问</a>
      <a href="#sources">内容依据</a>
    </nav>

    <section id="timeline" class="fd-section" aria-labelledby="timeline-h">
      <h2 id="timeline-h">按月龄怎么加</h2>
      <p class="small muted">不是「几个月必须会吃什么」的达标表，是多数孩子在这个阶段的推进顺序。</p>
      <ol class="fd-timeline">
        {
          feeding.stages.map((s) => (
            <li id={s.id}>
              <span class="fd-dot" aria-hidden="true"></span>
              <div class="fd-stage">
                <div class="fd-stage-head">
                  <span class="fd-age">{s.age}</span>
                  <span class="fd-label">{s.label}</span>
                </div>
                <dl class="fd-facts">
                  <div><dt>频次</dt><dd>{s.freq}</dd></div>
                  <div><dt>奶</dt><dd>{s.milk}</dd></div>
                  <div><dt>质地</dt><dd>{s.texture}</dd></div>
                  <div><dt>举例</dt><dd>{s.examples}</dd></div>
                </dl>
                <ul class="fd-points">
                  {s.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="table" class="fd-section" aria-labelledby="table-h">
      <h2 id="table-h">频次与质地，一张表看完</h2>
      <div class="fd-scroll">
        <table class="src-table fd-table">
          <thead>
            <tr><th scope="col">月龄</th><th scope="col">辅食频次</th><th scope="col">质地</th><th scope="col">奶</th></tr>
          </thead>
          <tbody>
            {
              feeding.stages.map((s) => (
                <tr>
                  <td data-label="月龄"><strong>{s.age}</strong></td>
                  <td data-label="辅食频次">{s.freq}</td>
                  <td data-label="质地">{s.texture}</td>
                  <td data-label="奶">{s.milk}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted">频次数字照录国家卫健委《婴幼儿喂养健康教育核心信息》，具体食量按孩子的饥饿与饱足信号调整。</p>
    </section>

    <section id="principles" class="fd-section" aria-labelledby="principles-h">
      <h2 id="principles-h">五条原则</h2>
      <div class="fd-cards">
        {
          feeding.principles.map((p, i) => (
            <article class="fd-card" id={p.id}>
              <span class="fd-card-no">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="groups" class="fd-section" aria-labelledby="groups-h">
      <h2 id="groups-h">7 类食物，每天至少覆盖 4 类</h2>
      <p class="small muted">每日至少包含一种动物性食物、一种蔬菜和一种谷薯类。这是判断「吃得够不够杂」最实用的尺子。</p>
      <div class="fd-groups">
        {feeding.groups.map((g) => <span>{g}</span>)}
      </div>
    </section>

    <section id="hazards" class="fd-section" aria-labelledby="hazards-h">
      <h2 id="hazards-h">安全红线</h2>
      <div class="fd-hazards">
        {
          feeding.hazards.map((h) => (
            <div class="fd-hazard" id={h.id}>
              <h3>{h.title}</h3>
              <p>{h.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="small muted">
        出现呛咳、呼吸困难、面色发紫时请立即就医或拨打 120，相关处理见
        <a href={withBase('/quick/choking')}>「气道异物」急症条目</a>。
      </p>
    </section>

    <section id="faq" class="fd-section" aria-labelledby="faq-h">
      <h2 id="faq-h">常见疑问</h2>
      <div class="knowledge-list">
        {
          feeding.faq.map((f) => (
            <details class="kcard">
              <summary><span class="k">{f.q}</span></summary>
              <div class="body"><p>{f.a}</p></div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="fd-section" aria-labelledby="more-h">
      <h2 id="more-h">站内按月龄的喂养条目</h2>
      <div class="entry-grid">
        {
          feeding.related.map((r) => (
            <a class="entry-card" href={relatedHref(r)}>
              <span class="k">{r.title}</span>
              <p class="sum">{r.age === 'acute' ? '急症 · 不按月龄筛选' : `${r.age.replace('-', '～')} 月龄阶段`} · 点开看完整说明与来源。</p>
            </a>
          ))
        }
      </div>
    </section>

    <section id="sources" class="notice fd-source" aria-labelledby="sources-h">
      <h2 id="sources-h">内容依据</h2>
      <ul class="doclist">
        {
          feeding.sources.map((s) => (
            <li>
              <strong>《{s.name}》</strong>
              <span>{s.org} · {s.doc} · {s.year}</span>
            </li>
          ))
        }
      </ul>
      <p class="small muted" style="margin-top:.9rem;margin-bottom:0;">
        本页为公开指南的结构化整理，不替代儿科或儿童保健医生的个体化建议；孩子有生长迟缓、反复呕吐、明确过敏等情况时请就医。
        与指南原文有出入时，以原文为准。更多引用见<a href={withBase('/sources')}>来源与声明</a>。
      </p>
    </section>
  </div>

  <style>
    .fd-lead {
      margin: 1rem 0 0;
      padding: 0.9rem 1.05rem;
      border-left: 3px solid var(--brand);
      background: var(--brand-wash);
      border-radius: 10px;
      font-size: 0.92rem;
      line-height: 1.7;
      color: var(--ink-soft);
    }
    .fd-lead strong { color: var(--brand-deep); }
    .fd-toc {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.9rem;
      margin: 1rem 0 0;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.86rem;
    }
    .fd-toc a { color: var(--ink-soft); min-height: 44px; display: inline-flex; align-items: center; }
    .fd-section { margin-top: 2.2rem; scroll-margin-top: 1rem; }
    .fd-section > h2 { font-size: 1.12rem; margin-bottom: 0.2rem; }

    .fd-timeline { list-style: none; margin: 1rem 0 0; padding: 0 0 0 1.4rem; border-left: 2px solid var(--line); }
    .fd-timeline > li { position: relative; padding: 0 0 1.1rem 0.6rem; margin: 0; }
    .fd-timeline > li:last-child { padding-bottom: 0; }
    .fd-dot {
      position: absolute; left: -1.98rem; top: 0.65rem;
      width: 12px; height: 12px; border-radius: 50%;
      background: var(--brand); border: 3px solid var(--surface);
      box-shadow: 0 0 0 1px var(--brand);
    }
    .fd-stage {
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--surface);
      padding: 0.95rem 1.05rem;
      box-shadow: var(--shadow-sm);
    }
    .fd-stage-head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .fd-age { font-size: 1.04rem; font-weight: 700; color: var(--brand-deep); }
    .fd-label { font-size: 0.78rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0.05rem 0.5rem; }
    .fd-facts { display: grid; grid-template-columns: 5rem 1fr; gap: 0.25rem 0.7rem; margin: 0 0 0.7rem; font-size: 0.86rem; }
    .fd-facts > div { display: contents; }
    .fd-facts dt { color: var(--muted); font-size: 0.8rem; padding-top: 0.1rem; }
    .fd-facts dd { margin: 0; color: var(--ink); line-height: 1.55; }
    .fd-points { margin: 0; padding-left: 1.1rem; border-top: 1px dashed var(--line); padding-top: 0.6rem; }
    .fd-points li { font-size: 0.86rem; color: var(--ink-soft); line-height: 1.65; margin-bottom: 0.3rem; }
    .fd-points li:last-child { margin-bottom: 0; }

    .fd-scroll { overflow-x: auto; }
    .fd-table { margin-top: 0.7rem; }
    .fd-table td:last-child, .fd-table th:last-child { white-space: normal; }
    .fd-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.65rem; margin-top: 0.9rem; }
    .fd-card { padding: 0.95rem 1rem; border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: 12px; background: var(--surface); }
    .fd-card-no { font: 700 0.74rem var(--ff-mono); color: var(--muted); letter-spacing: 0.08em; }
    .fd-card h3 { font-size: 0.98rem; margin: 0.25rem 0 0.35rem; }
    .fd-card p { font-size: 0.85rem; color: var(--ink-soft); line-height: 1.65; margin: 0; }
    .fd-groups { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.8rem; }
    .fd-groups span {
      padding: 0.35rem 0.75rem; border-radius: 999px;
      background: var(--surface-warm); border: 1px solid var(--line);
      color: var(--ink-soft); font-size: 0.85rem;
    }
    .fd-hazards { display: grid; gap: 0.55rem; margin-top: 0.8rem; }
    .fd-hazard { padding: 0.8rem 0.95rem; border: 1px solid var(--danger-line); border-left: 3px solid var(--danger); border-radius: 10px; background: var(--danger-wash); }
    .fd-hazard h3 { font-size: 0.94rem; color: var(--danger); margin: 0 0 0.25rem; }
    .fd-hazard p { font-size: 0.86rem; color: var(--ink-soft); line-height: 1.65; margin: 0; }
    .fd-source { margin-bottom: 1rem; }
    @media (max-width: 420px) {
      .fd-facts { grid-template-columns: 4rem 1fr; }
    }
  </style>
</BaseLayout>
