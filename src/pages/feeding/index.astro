---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import feeding from '../../content/data/feeding.json';
import recipes from '../../content/data/recipes.json';
import ReviewNotice from '../../components/ReviewNotice.astro';

const relatedHref = (r: { slug: string; age: string }) =>
  r.age === 'acute' ? withBase(`/quick/${r.slug}`) : withBase(`/age/${r.age}`) + '#' + r.slug;
---

<BaseLayout
  title={feeding.title}
  description="满 6 月龄起添加辅食：按月龄的频次与质地对照、五条添加原则、安全红线与常见误区。依据国家卫健委《婴幼儿喂养健康教育核心信息》与中国居民膳食指南（2022）。"
  nav="feeding"
>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">0～3 岁 · 喂养</p>
      <h1>{feeding.title}</h1>
      <p class="tagline">{feeding.tagline}</p>
    </div>

    <ReviewNotice />

    <div class="fd-lead">
      <strong>一句话先记住：</strong>满 6 月龄开始加，先加含铁的泥糊状食物，每次只加一种、观察 2～3 天；
      1 岁以内不加盐、糖和调味品；继续母乳喂养可至 2 岁及以上。
    </div>

    <nav class="fd-toc" aria-label="本页目录">
      <a href="#timeline">按月龄怎么加</a>
      <a href="#table">频次与质地表</a>
      <a href="#principles">五条原则</a>
      <a href="#groups">7 类食物</a>
      <a href="#recipes">辅食菜单</a>
      <a href="#hazards">安全红线</a>
      <a href="#faq">常见疑问</a>
      <a href="#sources">内容依据</a>
    </nav>

    <section id="timeline" class="fd-section" aria-labelledby="timeline-h">
      <h2 id="timeline-h">按月龄怎么加</h2>
      <p class="small muted">不是「几个月必须会吃什么」的达标表，是多数孩子在这个阶段的推进顺序。</p>
      <ol class="fd-timeline">
        {
          feeding.stages.map((s) => (
            <li id={s.id}>
              <span class="fd-dot" aria-hidden="true"></span>
              <div class="fd-stage">
                <div class="fd-stage-head">
                  <span class="fd-age">{s.age}</span>
                  <span class="fd-label">{s.label}</span>
                </div>
                <dl class="fd-facts">
                  <div><dt>频次</dt><dd>{s.freq}</dd></div>
                  <div><dt>奶</dt><dd>{s.milk}</dd></div>
                  <div><dt>质地</dt><dd>{s.texture}</dd></div>
                  <div><dt>举例</dt><dd>{s.examples}</dd></div>
                </dl>
                <ul class="fd-points">
                  {s.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="table" class="fd-section" aria-labelledby="table-h">
      <h2 id="table-h">频次与质地，一张表看完</h2>
      <div class="fd-scroll">
        <table class="src-table fd-table">
          <thead>
            <tr><th scope="col">月龄</th><th scope="col">辅食频次</th><th scope="col">质地</th><th scope="col">奶</th></tr>
          </thead>
          <tbody>
            {
              feeding.stages.map((s) => (
                <tr>
                  <td data-label="月龄"><strong>{s.age}</strong></td>
                  <td data-label="辅食频次">{s.freq}</td>
                  <td data-label="质地">{s.texture}</td>
                  <td data-label="奶">{s.milk}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted">频次数字照录国家卫健委《婴幼儿喂养健康教育核心信息》，具体食量按孩子的饥饿与饱足信号调整。</p>
    </section>

    <section id="principles" class="fd-section" aria-labelledby="principles-h">
      <h2 id="principles-h">五条原则</h2>
      <div class="fd-cards">
        {
          feeding.principles.map((p, i) => (
            <article class="fd-card" id={p.id}>
              <span class="fd-card-no">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="groups" class="fd-section" aria-labelledby="groups-h">
      <h2 id="groups-h">7 类食物，每天至少覆盖 4 类</h2>
      <p class="small muted">每日至少包含一种动物性食物、一种蔬菜和一种谷薯类。这是判断「吃得够不够杂」最实用的尺子。</p>
      <div class="fd-groups">
        {feeding.groups.map((g) => <span>{g}</span>)}
      </div>
    </section>

    <section id="recipes" class="fd-section" aria-labelledby="recipes-h">
      <h2 id="recipes-h">辅食菜单：{recipes.items.length} 道能当天做完的</h2>
      <p class="small muted">{recipes.intro}</p>

      <div class="fd-filters" role="group" aria-label="按适合月龄筛选菜单">
        <button type="button" class="fd-filter is-on" data-recipe-filter="all" aria-pressed="true">全部</button>
        <button type="button" class="fd-filter" data-recipe-filter="6" aria-pressed="false">6～8 月龄</button>
        <button type="button" class="fd-filter" data-recipe-filter="9" aria-pressed="false">9～11 月龄</button>
        <button type="button" class="fd-filter" data-recipe-filter="12" aria-pressed="false">12 月龄以上</button>
      </div>

      <div class="fd-recipes" id="fd-recipes">
        {
          recipes.items.map((r) => (
            <details class="fd-recipe" id={`recipe-${r.id}`} data-recipe-month={String(r.monthFrom)}>
              <summary>
                <span class="fd-recipe-main">
                  <span class="fd-recipe-name">{r.name}</span>
                  <span class="fd-recipe-meta">{r.monthLabel} · {r.texture} · {r.time}</span>
                </span>
                <span class="fd-recipe-tags">
                  {r.tags.map((t) => <span class="tag">{t}</span>)}
                  <span class="fd-toggle" aria-hidden="true">+</span>
                </span>
              </summary>
              <div class="fd-recipe-body">
                <div class="fd-recipe-col">
                  <h3>材料</h3>
                  <ul class="fd-ing">{r.ingredients.map((i) => <li>{i}</li>)}</ul>
                </div>
                <div class="fd-recipe-col">
                  <h3>做法</h3>
                  <ol class="fd-steps">{r.steps.map((s) => <li>{s}</li>)}</ol>
                </div>
                <p class="fd-tip"><strong>注意</strong>{r.tip}</p>
              </div>
            </details>
          ))
        }
      </div>

      <p class="small muted fd-recipes-note" id="fd-recipes-empty" hidden>这个月龄段暂时没有菜单，先按上方「按月龄怎么加」的质地推进。</p>
      <p class="small muted">{recipes.note}</p>
    </section>

    <section id="hazards" class="fd-section" aria-labelledby="hazards-h">
      <h2 id="hazards-h">安全红线</h2>
      <div class="fd-hazards">
        {
          feeding.hazards.map((h) => (
            <div class="fd-hazard" id={h.id}>
              <h3>{h.title}</h3>
              <p>{h.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="small muted">
        出现呛咳、呼吸困难、面色发紫时请立即就医或拨打 120，相关处理见
        <a href={withBase('/quick/choking')}>「气道异物」急症条目</a>。
      </p>
    </section>

    <section id="faq" class="fd-section" aria-labelledby="faq-h">
      <h2 id="faq-h">常见疑问</h2>
      <div class="knowledge-list">
        {
          feeding.faq.map((f) => (
            <details class="kcard">
              <summary><span class="k">{f.q}</span></summary>
              <div class="body"><p>{f.a}</p></div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="fd-section" aria-labelledby="more-h">
      <h2 id="more-h">站内按月龄的喂养条目</h2>
      <div class="entry-grid">
        {
          feeding.related.map((r) => (
            <a class="entry-card" href={relatedHref(r)}>
              <span class="k">{r.title}</span>
              <p class="sum">{r.age === 'acute' ? '急症 · 不按月龄筛选' : `${r.age.replace('-', '～')} 月龄阶段`} · 点开看完整说明与来源。</p>
            </a>
          ))
        }
      </div>
    </section>

    <section id="sources" class="notice fd-source" aria-labelledby="sources-h">
      <h2 id="sources-h">内容依据</h2>
      <ul class="doclist">
        {
          feeding.sources.map((s) => (
            <li>
              <strong>《{s.name}》</strong>
              <span>{s.org} · {s.doc} · {s.year}</span>
            </li>
          ))
        }
      </ul>
      <p class="small muted u-mt-md u-mb-0">
        本页为公开指南的结构化整理，不替代儿科或儿童保健医生的个体化建议；孩子有生长迟缓、反复呕吐、明确过敏等情况时请就医。
        与指南原文有出入时，以原文为准。更多引用见<a href={withBase('/sources')}>来源与声明</a>。
      </p>
    </section>
  </div>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-recipe-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-recipe-month]'));
    const emptyHint = document.getElementById('fd-recipes-empty');

    function matchMonth(month: number, filter: string) {
      if (filter === 'all') return true;
      if (filter === '6') return month <= 8;
      if (filter === '9') return month >= 9 && month <= 11;
      return month >= 12;
    }

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.recipeFilter ?? 'all';
        filters.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', String(on));
        });
        let shown = 0;
        cards.forEach((card) => {
          const ok = matchMonth(Number(card.dataset.recipeMonth ?? '0'), filter);
          card.hidden = !ok;
          if (ok) shown += 1;
        });
        if (emptyHint) emptyHint.hidden = shown !== 0;
      });
    });
  </script>

  <style>
    .fd-lead {
      margin: var(--sp-8) 0 0;
      padding: var(--sp-8) var(--sp-8);
      border-left: 3px solid var(--brand);
      background: var(--brand-wash);
      border-radius: var(--r-md);
      font-size: var(--fs-md);
      line-height: 1.7;
      color: var(--ink-soft);
    }
    .fd-lead strong { color: var(--brand-deep); }
    .fd-toc {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3) var(--sp-8);
      margin: var(--sp-8) 0 0;
      padding-bottom: var(--sp-8);
      border-bottom: 1px solid var(--line);
      font-size: var(--fs-sm);
    }
    .fd-toc a { color: var(--ink-soft); min-height: 44px; display: inline-flex; align-items: center; }
    .fd-section { margin-top: var(--sp-20); scroll-margin-top: 1rem; }
    .fd-section > h2 { font-size: var(--fs-lg); margin-bottom: var(--sp-2); }

    .fd-timeline { list-style: none; margin: var(--sp-8) 0 0; padding: 0 0 0 var(--sp-12); border-left: 2px solid var(--line); }
    .fd-timeline > li { position: relative; padding: 0 0 var(--sp-8) var(--sp-5); margin: 0; }
    .fd-timeline > li:last-child { padding-bottom: 0; }
    .fd-dot {
      position: absolute; left: -1.98rem; top: 0.65rem;
      width: 12px; height: 12px; border-radius: 50%;
      background: var(--brand); border: 3px solid var(--surface);
      box-shadow: 0 0 0 1px var(--brand);
    }
    .fd-stage {
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      background: var(--surface);
      padding: var(--sp-8) var(--sp-8);
      box-shadow: var(--shadow-sm);
    }
    .fd-stage-head { display: flex; align-items: baseline; gap: var(--sp-5); flex-wrap: wrap; margin-bottom: var(--sp-5); }
    .fd-age { font-size: var(--fs-base); font-weight: 700; color: var(--brand-deep); }
    .fd-label { font-size: var(--fs-2xs); color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: var(--sp-1) var(--sp-4); }
    .fd-facts { display: grid; grid-template-columns: 5rem 1fr; gap: var(--sp-2) var(--sp-6); margin: 0 0 var(--sp-6); font-size: var(--fs-sm); }
    .fd-facts > div { display: contents; }
    .fd-facts dt { color: var(--muted); font-size: var(--fs-xs); padding-top: var(--sp-1); }
    .fd-facts dd { margin: 0; color: var(--ink); line-height: 1.55; }
    .fd-points { margin: 0; padding-left: var(--sp-8); border-top: 1px dashed var(--line); padding-top: var(--sp-5); }
    .fd-points li { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.65; margin-bottom: var(--sp-2); }
    .fd-points li:last-child { margin-bottom: 0; }

    .fd-scroll { overflow-x: auto; }
    .fd-table { margin-top: var(--sp-6); }
    .fd-table td:last-child, .fd-table th:last-child { white-space: normal; }
    .fd-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--sp-5); margin-top: var(--sp-8); }
    .fd-card { padding: var(--sp-8) var(--sp-8); border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: var(--r-md); background: var(--surface); }
    .fd-card-no { font: 700 var(--fs-2xs) var(--ff-mono); color: var(--muted); letter-spacing: 0.08em; }
    .fd-card h3 { font-size: var(--fs-base); margin: var(--sp-2) 0 var(--sp-3); }
    .fd-card p { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.65; margin: 0; }
    .fd-groups { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin-top: var(--sp-6); }
    .fd-groups span {
      padding: var(--sp-3) var(--sp-6); border-radius: 999px;
      background: var(--surface-warm); border: 1px solid var(--line);
      color: var(--ink-soft); font-size: var(--fs-sm);
    }
    .fd-hazards { display: grid; gap: var(--sp-4); margin-top: var(--sp-6); }
    .fd-hazard { padding: var(--sp-6) var(--sp-8); border: 1px solid var(--danger-line); border-left: 3px solid var(--danger); border-radius: var(--r-md); background: var(--danger-wash); }
    .fd-hazard h3 { font-size: var(--fs-md); color: var(--danger); margin: 0 0 var(--sp-2); }
    .fd-hazard p { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.65; margin: 0; }
    .fd-source { margin-bottom: var(--sp-8); }
    .fd-filters { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin: var(--sp-8) 0 var(--sp-2); }
    .fd-filter {
      min-height: 44px; padding: var(--sp-2) var(--sp-6);
      border: 1px solid var(--line); border-radius: 999px;
      background: var(--surface); color: var(--ink-soft);
      font: inherit; font-size: var(--fs-xs); cursor: pointer;
    }
    .fd-filter:hover { border-color: var(--brand); color: var(--brand-deep); }
    .fd-filter.is-on {
      background: var(--brand); border-color: var(--brand); color: #fff; font-weight: 700;
    }
    .fd-recipes { display: grid; gap: var(--sp-5); margin-top: var(--sp-6); }
    .fd-recipe {
      border: 1px solid var(--line); border-radius: var(--r-lg);
      background: var(--surface); box-shadow: var(--shadow-sm);
      overflow: hidden; scroll-margin-top: 1rem;
    }
    .fd-recipe[hidden] { display: none; }
    .fd-recipe > summary {
      display: flex; flex-wrap: wrap; gap: var(--sp-4) var(--sp-6);
      align-items: center; justify-content: space-between;
      padding: var(--sp-6) var(--sp-8); cursor: pointer; list-style: none;
    }
    .fd-recipe > summary::-webkit-details-marker { display: none; }
    .fd-recipe > summary:hover { background: var(--surface-warm); }
    .fd-recipe-main { display: flex; flex-direction: column; gap: var(--sp-1); flex: 1; min-width: 12rem; }
    .fd-recipe-name { font-weight: 700; font-size: var(--fs-base); color: var(--ink); }
    .fd-recipe-meta { font-size: var(--fs-2xs); color: var(--muted); }
    .fd-recipe-tags { display: inline-flex; flex-wrap: wrap; gap: var(--sp-2); align-items: center; }
    .fd-toggle {
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; border-radius: 50%;
      border: 1px solid var(--line); color: var(--brand-deep);
      font-size: var(--fs-base); line-height: 1; transition: transform .16s ease;
    }
    .fd-recipe[open] .fd-toggle { transform: rotate(45deg); border-color: var(--brand); }
    .fd-recipe[open] > summary { background: var(--surface-warm); }
    .fd-recipe-body {
      display: grid; gap: var(--sp-8) var(--sp-10);
      padding: var(--sp-2) var(--sp-8) var(--sp-8);
      border-top: 1px dashed var(--line-soft);
    }
    .fd-recipe-col h3 {
      font-size: var(--fs-2xs); font-weight: 700; letter-spacing: 0.06em;
      color: var(--muted); margin: var(--sp-6) 0 var(--sp-2);
    }
    .fd-ing, .fd-steps { margin: 0; font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.68; }
    .fd-ing { list-style: none; padding-left: 0; }
    .fd-steps { padding-left: var(--sp-10); }
    .fd-ing li { display: flex; gap: var(--sp-3); }
    .fd-ing li::before { content: "·"; color: var(--brand); font-weight: 700; }
    .fd-tip {
      margin: 0; padding: var(--sp-5) var(--sp-6);
      border-left: 3px solid var(--brand); border-radius: var(--r-md);
      background: var(--brand-wash);
      font-size: var(--fs-sm); line-height: 1.65; color: var(--ink-soft);
    }
    .fd-tip strong { margin-right: var(--sp-4); color: var(--brand-deep); }
    .fd-recipes-note { margin-top: var(--sp-8); }
    @media (min-width: 560px) {
      .fd-recipe-body { grid-template-columns: 13rem 1fr; }
      .fd-tip { grid-column: 1 / -1; }
    }
    @media (max-width: 420px) {
      .fd-facts { grid-template-columns: 4rem 1fr; }
    }
  </style>
</BaseLayout>
