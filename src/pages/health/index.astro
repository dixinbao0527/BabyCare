---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import { CATEGORY_ORDER, CATEGORY_LABEL } from '../../lib/stages';
import handbook from '../../content/data/handbook.json';
import ReviewNotice from '../../components/ReviewNotice.astro';

const acute = (await getCollection('acute')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'zh-CN')
);
const dev = await getCollection('developmental', ({ data }) => !data.draft);
const groups = CATEGORY_ORDER.map((cat) => ({
  cat,
  label: CATEGORY_LABEL[cat],
  items: dev
    .filter((e) => e.data.category === cat)
    .sort((a, b) => a.data.age_range.localeCompare(b.data.age_range) || a.data.order - b.data.order),
})).filter((g) => g.items.length > 0);

const handbookHref = (id: string) => withBase('/health/handbook') + '#' + id;

/** 高频问题不按月龄划分，单独在入口处给一条固定通道 */
const commonConcerns = ['infant-fever', 'diarrhea-care', 'cough', 'rash']
  .map((slug) => dev.find((e) => e.id.endsWith('/' + slug)))
  .filter((e) => e !== undefined);
---

<BaseLayout
  title="健康查询"
  description="把症状速查与婴幼儿高危疾病识别手册合并到一个入口：急症分级、12 类高危问题红线、按月龄知识，一次搜得到。"
  nav="health"
>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">症状速查 + 高危疾病识别</p>
      <h1>健康查询</h1>
      <p class="tagline">
        两条路径，一个入口：着急时用症状速查判断紧急程度；心里不踏实时，用高危手册核对红线信号。
        都不要替代医生——它们只帮你决定「现在该不该走、走多快、去了说什么」。
      </p>
    </div>

    <ReviewNotice />

    <div class="search-box">
      <span class="glass" aria-hidden="true">⌕</span>
      <label class="sr-only" for="q">搜索症状、疾病或关键词</label>
      <input
        id="q"
        type="search"
        enterkeyhint="search"
        placeholder="搜症状、疾病或关键词：抽搐、川崎病、辅食…"
        autocomplete="off"
        aria-controls="search-results"
      />
    </div>
    <div id="search-results" hidden aria-live="polite"></div>

    <div id="default-view">
      <div class="channel-grid" aria-label="两条查询路径">
        <a class="channel channel-quick" href="#acute-h">
          <span class="ch-no">路径 01</span>
          <span class="ch-k">急症速查</span>
          <span class="ch-d">
            {acute.length} 条急症三级分诊，固定置顶、不按月龄筛选；{dev.length} 条按月龄知识可按分类展开。
          </span>
          <span class="ch-go">先看急症 →</span>
        </a>
        <a class="channel channel-risk" href={withBase('/health/handbook')}>
          <span class="ch-no">路径 02</span>
          <span class="ch-k">高危疾病识别手册</span>
          <span class="ch-d">
            12 类低概率、高后果的问题：概率、为什么容易漏、红线信号、检查点、关键时间窗。
          </span>
          <span class="ch-go">阅读完整手册 →</span>
        </a>
      </div>

      <section class="h-section" aria-labelledby="acute-h">
        <div class="h-head">
          <h2 id="acute-h">急症与突发状况<span class="tag tag-acute">急症</span></h2>
          <span class="h-links">
            <a class="more" href={withBase('/quick/card')}>打印急救卡</a>
          </span>
        </div>
        <p class="small muted">不按月龄筛选，任何年龄都可能遇到。点开看三级分诊：观察 / 立即就医 / 立即呼救。</p>
        <div class="qlist">
          {
            acute.map((a) => (
              <a class="qitem" href={withBase(`/quick/${a.id}`)}>
                <span class="row">
                  <span class="tag tag-acute">急症</span>
                  <span class="t">{a.data.title}</span>
                </span>
                <span class="s">{a.data.summary}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="h-section" aria-labelledby="common-h">
        <div class="h-head">
          <h2 id="common-h">最常遇到的四件事</h2>
        </div>
        <p class="small muted">发热、腹泻、咳嗽、皮疹——不按月龄分，家里先用得上。</p>
        <div class="entry-grid is-pair">
          {
            commonConcerns.map((e) => (
              <a class="entry-card" href={withBase(`/age/${e.data.age_range}`) + '#' + e.id.split('/').pop()}>
                <span class="k">{e.data.title}</span>
                <p class="sum">{e.data.summary}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="h-section" aria-labelledby="risk-h">
        <div class="h-head">
          <h2 id="risk-h">十二类高危问题</h2>
          <a class="more" href={withBase('/health/handbook')}>完整手册 →</a>
        </div>
        <p class="small muted">
          按「概率 / 决策窗口 / 一句话红线」先看全貌，点任意一条直达手册中的逐项详解与来源。
        </p>
        <div class="risk-grid">
          {
            handbook.items.map((it) => (
              <a class="risk-card" href={handbookHref(it.id)}>
                <span class="risk-top">
                  <span class="risk-no">{it.no}</span>
                  <span class={`risk-window risk-${it.level}`}>{it.window}</span>
                </span>
                <span class="risk-name">{it.name}</span>
                <span class="risk-red">{it.redline}</span>
                <span class="risk-prob">{it.probability}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="h-section" aria-labelledby="tools-h">
        <div class="h-head">
          <h2 id="tools-h">手册里的通用工具</h2>
        </div>
        <p class="small muted">比记住 12 种病更重要的，是这几页可反复用的标尺与操作卡。</p>
        <div class="entry-grid">
          {
            handbook.tools.map((t) => (
              <a class="entry-card" href={handbookHref(t.id)}>
                <span class="k">{t.name}</span>
                <p class="sum">{t.desc}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="h-section" id="browse" aria-labelledby="cat-h">
        <div class="h-head">
          <h2 id="cat-h">按月龄分类浏览</h2>
          <span class="more">共 {dev.length} 条</span>
        </div>
        <p class="small muted">选一个分类展开；也可以直接用上面的搜索。</p>

        <div class="cat-toggle" role="group" aria-label="按分类筛选">
          {
            groups.map((g) => (
              <button type="button" data-cat={g.cat} aria-pressed="false">
                {g.label}（{g.items.length}）
              </button>
            ))
          }
        </div>

        <p class="small muted" id="cat-hint">选择一个分类，或直接用上面的搜索框。</p>

        {
          groups.map((g) => (
            <div data-cat-group={g.cat} hidden>
              <h3 class="group-title">
                {g.label}
                <span class="count">{g.items.length} 条</span>
              </h3>
              <div class="qlist">
                {g.items.map((d) => (
                  <a
                    class="qitem"
                    href={withBase(`/age/${d.data.age_range}`) + '#' + (d.id.split('/').pop() ?? '')}
                  >
                    <span class="row">
                      <span class="t">{d.data.title}</span>
                      <span class="tag">{d.data.age_range.replace('-', '～')}</span>
                    </span>
                    <span class="s">{d.data.summary}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <p class="h-alert">
        孩子出现呼吸困难、意识改变、抽搐、面色发青、压之不褪色皮疹时，请立即拨打 120 或前往急诊，
        不要以本站内容作为是否就医的唯一依据。
      </p>
    </div>
  </div>

  <script>
    import { withBase } from '../../lib/url';
    import { rankByMatch, isLiteralQuery, literalFilter } from '../../lib/search';

    const input = document.getElementById('q') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    const defaultView = document.getElementById('default-view');

    type Item = {
      slug: string;
      path?: string;
      title: string;
      tags: string[];
      summary: string;
      type: 'acute' | 'developmental' | 'outdoor' | 'handbook' | 'feeding';
      category: string;
      age_range: string;
    };

    const TYPE_LABEL: Record<string, string> = {
      acute: '急症',
      developmental: '知识',
      outdoor: '户外',
      handbook: '高危手册',
      feeding: '辅食',
    };

    let items: Item[] | null = null;
    let fuse: { search: (q: string) => { item: Item }[] } | null = null;
    let loading: Promise<void> | null = null;

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
      );

    function mark(text: string, q: string): string {
      const safe = esc(text);
      const needle = esc(q);
      if (!needle) return safe;
      const idx = safe.toLowerCase().indexOf(needle.toLowerCase());
      if (idx < 0) return safe;
      return safe.slice(0, idx) + '<mark>' + safe.slice(idx, idx + needle.length) + '</mark>' + safe.slice(idx + needle.length);
    }

    function hrefOf(it: Item): string {
      if (it.path) return withBase(it.path);
      if (it.type === 'acute') return withBase(`/quick/${it.slug}`);
      if (it.type === 'outdoor') return withBase(`/outdoor#venue-${it.slug}`);
      return withBase(`/age/${it.age_range}`) + '#' + it.slug;
    }

    function render(list: Item[], q: string) {
      if (!results) return;
      if (list.length === 0) {
        results.innerHTML = `<div class="empty-result"><p class="empty-line"><strong>没找到「${esc(q)}」</strong></p><p class="small muted u-m-0">试试更短的词，或直接看 <a href="#acute-h">急症速查</a> 与 <a href="${withBase('/health/handbook')}">高危手册</a>。</p></div>`;
        return;
      }
      results.innerHTML =
        `<p class="small muted result-count">${list.length} 条结果</p><div class="qlist">` +
        list.map((it) => `
          <a class="qitem" href="${hrefOf(it)}">
            <span class="row">
              ${it.type === 'acute' ? '<span class="tag tag-acute">急症</span>' : ''}
              <span class="t">${mark(it.title, q)}</span>
              <span class="tag">${TYPE_LABEL[it.type] ?? '内容'}</span>
            </span>
            <span class="s">${mark(it.summary, q)}</span>
            <span class="meta">${it.tags.slice(0, 3).map((t) => `<span class="tag">${mark(t, q)}</span>`).join('')}</span>
          </a>`).join('') + '</div>';
    }

    function fallback(q: string): Item[] {
      const needle = q.toLowerCase();
      const scored: { it: Item; s: number }[] = [];
      for (const it of items ?? []) {
        let s = 0;
        if (it.title.toLowerCase().includes(needle)) s += 3;
        if (it.tags.some((t) => t.toLowerCase().includes(needle))) s += 2;
        if (it.summary.toLowerCase().includes(needle)) s += 1;
        if (s > 0) scored.push({ it, s });
      }
      scored.sort((a, b) => b.s - a.s);
      return scored.map((x) => x.it);
    }

    async function ensureIndex() {
      if (items) return;
      if (loading) return loading;
      loading = (async () => {
        try {
          const res = await fetch(withBase('/search-index.json'), { credentials: 'omit' });
          items = (await res.json()) as Item[];
          items.sort((a, b) => (a.type === b.type ? 0 : a.type === 'acute' ? -1 : 1));
        } catch { items = []; }
        try {
          const mod: any = await import('fuse.js');
          const Fuse = mod.default ?? mod;
          fuse = new Fuse(items, {
            threshold: 0.35,
            ignoreLocation: true,
            keys: [
              { name: 'title', weight: 3 },
              { name: 'tags', weight: 2 },
              { name: 'summary', weight: 1 },
            ],
          });
        } catch { fuse = null; }
      })();
      return loading;
    }

    async function run(query: string) {
      const q = query.trim();
      if (!q) {
        if (results) { results.hidden = true; results.innerHTML = ''; }
        if (defaultView) defaultView.hidden = false;
        return;
      }
      await ensureIndex();
      if (defaultView) defaultView.hidden = true;
      if (!results) return;
      results.hidden = false;
      let list: Item[] = fuse ? fuse.search(q).map((r) => r.item) : [];
      for (const it of fallback(q)) if (!list.includes(it)) list.push(it);
      if (isLiteralQuery(q)) list = literalFilter(list, q);
      list = rankByMatch(list, q);
      list = list.slice(0, 30);
      list.sort((a, b) => (a.type === b.type ? 0 : a.type === 'acute' ? -1 : 1));
      render(list, q);
    }

    let timer: number | undefined;
    input?.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run(input.value), 160);
    });
    input?.addEventListener('focus', () => void ensureIndex(), { once: true });
    if (location.hash === '#q' && input) input.focus({ preventScroll: false });

    // 分类浏览：一次展开一个分类
    const catChips = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
    const catGroups = document.querySelectorAll<HTMLElement>('[data-cat-group]');
    const catHint = document.getElementById('cat-hint');
    catChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.cat;
        const active = chip.getAttribute('aria-pressed') === 'true';
        catChips.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        if (active) {
          catGroups.forEach((g) => (g.hidden = true));
          if (catHint) catHint.hidden = false;
          return;
        }
        chip.setAttribute('aria-pressed', 'true');
        catGroups.forEach((g) => (g.hidden = g.dataset.catGroup !== cat));
        if (catHint) catHint.hidden = true;
      });
    });
  </script>

  <style>
    .channel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--sp-6);
      margin-top: var(--sp-12);
    }
    .channel {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      padding: var(--sp-10) var(--sp-10) var(--sp-8);
      border-radius: var(--r-lg);
      border: 1px solid var(--line);
      border-top: 4px solid var(--brand);
      background: var(--surface);
      color: var(--ink);
      box-shadow: var(--shadow-sm);
    }
    .channel:hover { text-decoration: none; border-color: var(--brand); }
    .channel-risk { border-top-color: var(--danger); background: var(--danger-wash); }
    .channel-risk:hover { border-color: var(--danger); }
    .ch-no { font-size: var(--fs-2xs); letter-spacing: 0.1em; color: var(--muted); font-weight: 700; }
    .ch-k { font-size: var(--fs-lg); font-weight: 700; line-height: 1.4; }
    .channel-risk .ch-k { color: var(--danger); }
    .ch-d { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.65; }
    .ch-go { margin-top: var(--sp-4); font-size: var(--fs-sm); font-weight: 700; color: var(--brand-deep); }
    .channel-risk .ch-go { color: var(--danger); }

    .h-section { margin-top: var(--sp-20); }
    .h-links { display: flex; align-items: baseline; gap: var(--sp-4); flex-wrap: wrap; }

    .h-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-6);
      margin-bottom: var(--sp-2);
    }
    .h-head h2 { font-size: var(--fs-xl); display: flex; align-items: center; gap: var(--sp-4); margin: 0; }
    .h-head .more { font-size: var(--fs-sm); white-space: nowrap; }

    .risk-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
      gap: var(--sp-5);
      margin-top: var(--sp-6);
    }
    .risk-card {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      padding: var(--sp-6) var(--sp-8);
      border: 1px solid var(--line);
      border-left: 3px solid var(--danger-line);
      border-radius: var(--r-md);
      background: var(--surface);
      color: var(--ink);
    }
    .risk-card:hover { border-color: var(--danger); border-left-color: var(--danger); text-decoration: none; }
    .risk-top { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); }
    .risk-no { font: 700 var(--fs-xs) var(--ff-mono); color: var(--muted); }
    .risk-window {
      font-size: var(--fs-2xs);
      font-weight: 700;
      padding: var(--sp-1) var(--sp-4);
      border-radius: 999px;
    }
    .risk-fast { background: var(--danger-wash); color: var(--danger); }
    .risk-mid { background: var(--warn-wash); color: var(--warn); }
    .risk-name { font-weight: 700; font-size: var(--fs-base); line-height: 1.45; }
    .risk-red { font-size: var(--fs-xs); color: var(--danger); line-height: 1.55; }
    .risk-prob { font-size: var(--fs-2xs); color: var(--muted); margin-top: auto; padding-top: var(--sp-2); }

    .h-alert {
      margin-top: var(--sp-16);
      padding: var(--sp-8) var(--sp-8);
      border: 1px solid var(--danger-line);
      border-radius: var(--r-md);
      background: var(--danger-wash);
      color: #7a2c26;
      font-size: var(--fs-sm);
      line-height: 1.65;
    }
  </style>
</BaseLayout>
