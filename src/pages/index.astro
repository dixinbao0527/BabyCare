---
import BaseLayout from '../layouts/BaseLayout.astro';
import BirthDatePicker from '../components/BirthDatePicker.astro';
import GrowthAxis from '../components/GrowthAxis.astro';
import MonthlyTasks from '../components/MonthlyTasks.astro';
import { getCollection } from 'astro:content';
import { STAGES, CATEGORY_META } from '../lib/stages';
import { withBase } from '../lib/url';

const all = await getCollection('developmental', ({ data }) => !data.draft);

// 首页每个阶段展示 order 最小的 4 条（不足则全部）
const byStage = new Map<string, typeof all>();
for (const s of STAGES) {
  byStage.set(
    s.range,
    all
      .filter((e) => e.data.age_range === s.range)
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 4)
  );
}

const acuteAll = (await getCollection('acute')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const acuteTop = acuteAll.slice(0, 3);

const counts = new Map<string, number>();
for (const e of all) counts.set(e.data.age_range, (counts.get(e.data.age_range) ?? 0) + 1);

const defaultStage = STAGES[0];
const defaultEntries = byStage.get(defaultStage.range) ?? [];
const defaultCount = counts.get(defaultStage.range) ?? 0;
const totalCount = all.length + acuteAll.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '婴幼儿健康养育手册',
  inLanguage: 'zh-CN',
  description: '0～3 岁婴幼儿健康养育手册，按月龄组织的可溯源知识地图。',
};
---

<BaseLayout title="婴幼儿健康养育手册" nav="home">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div class="wrap wrap-home">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero">
        <span class="eyebrow">0～3 岁 · 公益整理 · {totalCount} 条可溯源内容</span>
        <h1 id="hero-title">按月龄查，每条都能溯源</h1>
        <p class="lede">
          填一次生日，首页会记住宝宝现在的位置；不填也能按月龄浏览。喂养、睡眠、发育、安全、日常照护，
          急症单独成路，随时可查。
        </p>

        <BirthDatePicker />

        <p class="link-row">
          <a href={withBase('/quick')}>症状速查</a>
          <span aria-hidden="true" class="muted">·</span>
          <a href={withBase('/milestones')}>发育里程碑</a>
          <span aria-hidden="true" class="muted">·</span>
          <a href={withBase('/sources')}>内容依据</a>
        </p>
      </div>

      <div class="home-side">
        <GrowthAxis counts={Object.fromEntries(counts)} defaultRange={defaultStage.range} />
        <MonthlyTasks defaultRange={defaultStage.range} />
      </div>
    </section>

    <section class="section stage-section" aria-labelledby="stage-heading">
      <div class="section-head">
        <h2 id="stage-heading">
          <span id="stage-name">{defaultStage.name}</span>
          <span class="sub" id="stage-tagline">{defaultStage.tagline}</span>
        </h2>
        <a class="more" id="stage-more" href={withBase(`/age/${defaultStage.range}`)}>
          本阶段全部 {defaultCount} 条 →
        </a>
      </div>

      <div id="stage-panels">
        {
          STAGES.map((s) => {
            const entries = byStage.get(s.range) ?? [];
            return (
              <div data-stage-panel={s.range} data-count={counts.get(s.range) ?? 0} hidden={s.range !== defaultStage.range}>
                <div class="entry-grid">
                  {entries.map((e) => {
                    const cat = CATEGORY_META[e.data.category];
                    return (
                      <a
                        class={`entry-card ${cat?.tone ?? ''}`}
                        href={withBase(`/age/${s.range}`) + '#' + (e.id.split('/').pop() ?? '')}
                      >
                        <span class="card-top">
                          <span class="cat-badge" aria-hidden="true">{cat?.badge ?? '育'}</span>
                          <span class="cat-label">{cat?.label ?? '内容'}</span>
                        </span>
                        <span class="k">{e.data.title}</span>
                        <p class="sum">{e.data.summary}</p>
                        <span class="src">{e.data.source.tier} · {e.data.source.year}</span>
                      </a>
                    );
                  })}
                </div>
                {entries.length === 0 && <p class="small muted">这一阶段的内容正在补充。</p>}
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="section" aria-labelledby="quick-heading">
      <div class="section-head">
        <h2 id="quick-heading">急症与突发状况</h2>
        <a class="more" href={withBase('/quick')}>全部 {acuteAll.length} 条 →</a>
      </div>
      <p class="small muted" style="margin-top:-.3rem;margin-bottom:.8rem;">
        不按月龄筛选，任何年龄都可能遇到。
      </p>
      <div class="qlist">
        {
          acuteTop.map((a) => (
            <a class="qitem" href={withBase(`/quick/${a.id}`)}>
              <span class="row">
                <span class="tag tag-acute">急症</span>
                <span class="t">{a.data.title}</span>
              </span>
              <span class="s">{a.data.summary}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="more-heading">
      <div class="section-head">
        <h2 id="more-heading">还想看</h2>
      </div>
      <div class="entry-grid">
        <a class="entry-card" href={withBase('/milestones')}>
          <span class="k">发育里程碑对照</span>
          <p class="sum">
            8 个月龄节点 × 4 个维度，运动里程碑给出 WHO 窗口上下限；附国家卫健委预警征象自查清单。
          </p>
        </a>
        <a class="entry-card" href={withBase('/quick')}>
          <span class="k">症状快速查询</span>
          <p class="sum">输入「抽搐」「误吞」「辅食」这类你会说的词，急症条目固定置顶。</p>
        </a>
        <a class="entry-card" href={withBase('/sources')}>
          <span class="k">来源与声明</span>
          <p class="sum">全部引用指南的名称、发布机构、文号与年份；本站的边界与免责说明。</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
